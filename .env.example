# Copy to .env.local and fill in — NEVER commit real secrets.
# Your Atlas URI (URL-encode special chars in the password, e.g. @ → %40):
# mongodb+srv://ecell:<db_password>@cluster0.pnek51j.mongodb.net/?appName=Cluster0
MONGODB_URI=mongodb+srv://ecell:REPLACE_WITH_URL_ENCODED_PASSWORD@cluster0.pnek51j.mongodb.net/?appName=Cluster0
MONGODB_DB=illuminate

# Admin dashboard key (must match what you type at /admin).
# Change this from the demo default before launch.
ADMIN_PASSCODE=met2026
