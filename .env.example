# Copy to .env.local. Never commit real values.
# Required in production for database-backed registrations and proofs.
MONGODB_URI=mongodb+srv://USER:URL_ENCODED_PASSWORD@HOST/?appName=Cluster0
MONGODB_DB_NAME=illuminate

# Required in production for server-side admin authentication and private
# participant status tokens. Generate independent high-entropy secrets.
# Generate with: npm run admin:hash-password
ADMIN_PASSWORD_HASH=scrypt$REPLACE_WITH_SALT$REPLACE_WITH_HASH
ADMIN_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
PARTICIPANT_TOKEN_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Transactional email. Server-only: never expose these as NEXT_PUBLIC values.
# Production delivery requires a Resend-verified sending domain; do not use
# onboarding@resend.dev as the production sender.
RESEND_API_KEY=REPLACE_WITH_RESEND_SERVER_API_KEY
RESEND_FROM_EMAIL=Illuminate by E-Cell MET <updates@verified-domain.example>
RESEND_REPLY_TO_EMAIL=met.iot.ecell@gmail.com
APP_BASE_URL=https://your-verified-production-domain.example
# Development-only explicit live template test recipient. This command refuses production.
# RESEND_TEST_TO=developer@example.com

# Development only. Never set these in production, and never expose them as
# NEXT_PUBLIC variables. All three must be exactly 1 for the safe E2E workflow.
# REGISTRATION_PREVIEW=1
# PAYMENT_UI_PREVIEW=1
# PAYMENT_E2E_PREVIEW=1
